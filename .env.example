# ─── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4200
WEB_ORIGIN=http://localhost:5174
LOG_LEVEL=info

# ─── Postgres ──────────────────────────────────────────────────────────────
DATABASE_URL=postgres://ulugbektuxtayev@localhost:5432/lolasales

# ─── Auth (dashboard) ──────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
# Birinchi ishga tushirishda shu admin yaratiladi (npm run seed)
ADMIN_EMAIL=admin@lolasales.uz
ADMIN_PASSWORD=change-me
ADMIN_NAME=Ulugbek

# Telegram sessiya va api_hash shu kalit bilan shifrlanadi (32+ belgi).
# O'zgartirsangiz saqlangan sessiyalar o'qilmay qoladi!
ENCRYPTION_KEY=change-me-32-bytes-minimum-secret-key

# ─── Telegram MTProto (my.telegram.org → API development tools) ────────────
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Ixtiyoriy: MTProto ulanishini proksi orqali o'tkazish
TELEGRAM_PROXY=

# ─── Claude Agent SDK ──────────────────────────────────────────────────────
# Ikki xil kalit bor va ular BOSHQA-BOSHQA o'zgaruvchiga yoziladi:
#   • API kalit,  sk-ant-api… bilan boshlanadi  → ANTHROPIC_API_KEY
#   • Obuna tokeni, sk-ant-oat… bilan boshlanadi → CLAUDE_CODE_OAUTH_TOKEN
#     (Claude Code obunasi; `claude setup-token` buyrug'i bilan olinadi)
# Bittasini to'ldirish yetarli.
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
AGENT_MODEL=claude-sonnet-5
# auto — kalit turini prefiksidan o'zi aniqlaydi (tavsiya). Yoki: api | subscription
AGENT_AUTH_MODE=auto

# ─── OpenAI — FAQAT SOLISHTIRISH uchun ─────────────────────────────────────
# Ishlab turgan agent bularsiz ham to'liq ishlaydi: ular faqat
# `npm run ab-suhbat` stendida o'qiladi. Kalit bo'lmasa stend
# faqat hozirgi modelni ko'rsatadi.
# OPENAI_MODEL — provayder bergan ANIQ model nomi bo'lishi kerak.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_BASE_URL=https://api.openai.com/v1

# ─── Media va nutqni matnga o'girish (aisha.group) ─────────────────────────
# Mijoz ovozli xabar yuborsa, u matnga o'girilib agentga beriladi.
# Kalit: aisha.group → Space paneli → API key
AISHA_API_KEY=
AISHA_BASE_URL=https://back.aisha.group
STT_LANGUAGE=uz
STT_MAX_MB=20
STT_TIMEOUT_MS=120000
# XonzodaAI (o'zimizning STT) — FAQAT Aisha bilan solishtirish uchun: natija chatda
# Aisha matni ostida ko'rinadi, agentga bormaydi. Bo'sh qolsa solishtirish o'chiq.
# Kalit: platforma dashboard → Settings → API keys (xs_stt_…), faqat STT ni ochadi.
XONZODA_STT_API_KEY=
XONZODA_STT_BASE_URL=https://xonsaroy.adiz.uz/api/v1
# Kelgan rasm/ovoz/hujjatlar shu papkaga saqlanadi (loyiha ildiziga nisbatan)
MEDIA_DIR=storage/media
MEDIA_MAX_MB=50

# ─── Xavfsizlik / tezlik cheklovlari (dashboarddan ham sozlanadi) ──────────
# Yangi KAMPANIYA uchun kunlik standart. Bu akkauntning chegarasi EMAS —
# akkaunt chegarasi Telegram sahifasida, har akkaunt uchun alohida.
OUTREACH_DAILY_LIMIT=40
# Xabarlar orasidagi ENG QISQA pauza (sekund). Haqiqiy oraliq bundan
# uzunroq bo'ladi: u kunlik limitni ish vaqtiga taqsimlab hisoblanadi
# (600 daqiqa / 30 ta ≈ 20 daqiqa) va har safar tasodifiy — odam
# yozgandek. Bu ikki qiymat faqat pastki chegara.
OUTREACH_MIN_DELAY_SEC=60
OUTREACH_MAX_DELAY_SEC=180
# Ish vaqti oynasi (Asia/Tashkent)
OUTREACH_WINDOW_START=09:00
OUTREACH_WINDOW_END=19:00
TIMEZONE=Asia/Tashkent

# Mijoz ketma-ket bir necha xabar yozsa, agent shuncha millisekund kutib,
# hammasini BITTA javobga birlashtiradi. 0 — kutmaslik (har xabarga alohida javob).
AGENT_REPLY_DEBOUNCE_MS=8000

# Ommaviy Telegram tekshiruvida ikki qidiruv orasidagi pauza (millisekund).
# Telegram telefon qidiruvini qattiq cheklaydi — juda tez yuborilsa akkaunt
# FLOOD_WAIT ga tushadi va soatlab hech narsa yubora olmaydi.
TELEGRAM_LOOKUP_DELAY_MS=4000
# Global "to'xtat" tugmasi: true bo'lsa hech qanday xabar yuborilmaydi
KILL_SWITCH=false
# Agent avtomatik javob bersinmi (false bo'lsa faqat qoralama tayyorlaydi)
AGENT_AUTO_REPLY=true

# @SpamBot ni har 6 soatda avtomatik so'rash. Standart — o'chiq.
# Tekshiruvning o'zi ham faollik: akkaunt @SpamBot ga /start yozadi.
# Dashboarddagi qo'lda tekshirish tugmasi bunga bog'liq emas — doim ishlaydi.
SPAM_WATCH_ENABLED=false

# ─── Shartnomalar bazasi (app-api.xonsaroy.uz) ─────────────────────────────
# Kechikkan to'lov, to'lov grafigi va telefon raqamlari shu yerdan olinadi.
CONTRACTS_API_URL=https://app-api.xonsaroy.uz
# Zaxira manzillar (vergul bilan): asosiysi javob bermasa navbat bilan sinaladi.
CONTRACTS_API_FALLBACK_URLS=https://crm-api.xonapps.uz,https://app-api.xonsaroy.uz
CONTRACTS_API_CLIENT_ID=
CONTRACTS_API_CLIENT_SECRET=
CONTRACTS_API_USERNAME=
CONTRACTS_API_PASSWORD=
# false — integratsiya o'chadi, tizim faqat Excel importi bilan ishlaydi
CONTRACTS_SYNC_ENABLED=true
# Kechasi to'liq sinxronizatsiya soati (Asia/Tashkent)
CONTRACTS_SYNC_HOUR=3
CONTRACTS_SYNC_DELAY_MS=200
CONTRACTS_API_TIMEOUT_MS=15000
# Suhbat davomida shundan yangi ma'lumot qayta so'ralmaydi (daqiqa)
CONTRACTS_FRESH_MINUTES=30
# Shundan eski ma'lumot bilan mijozga birinchi xabar yuborilmaydi (soat)
CONTRACTS_STALE_HOURS=24

# ─── Baza zaxirasi (soatlik) ───────────────────────────────────────────
# Bularni ilova o'qimaydi — faqat scripts/backup.sh, uni systemd timer
# har soat chaqiradi. Shuning uchun config.ts da ham yo'q.
#
# BotFather'da ochilgan bot. U yopiq guruhga qo'shilgan bo'lishi kerak
# (admin qilish shart emas). Bo'sh qoldirilsa zaxira faqat diskka
# yoziladi — Telegramga hech narsa ketmaydi.
BACKUP_BOT_TOKEN=
# Guruh id — manfiy son, masalan -1001234567890
BACKUP_CHAT_ID=
BACKUP_DIR=/var/backups/lolasales
# Diskda saqlanadigan soatlik zaxiralar soni (48 ≈ 2 kun)
BACKUP_KEEP=48
